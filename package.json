{
  "name": "jir-mail-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./static/css/input.css -o ./static/css/tailwind-built.css --minify",
    "build:prod": "npm run build:css && cp ./static/css/main.css ./static/css/main.css.backup && cp ./static/css/tailwind-built.css ./static/css/main.css",
    "watch": "tailwindcss -i ./static/css/input.css -o ./static/css/main.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.0",
    "flowbite": "^2.3.0"
  }
}
