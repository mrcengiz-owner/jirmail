# Jîr-Mail Environment Variables for Coolify

# Database Configuration
DATABASE_URL=postgres://postgres:CHANGE_ME@postgres:5432/jir_mail_prod
POSTGRES_DB=jir_mail_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Mail Configuration
MAIL_DOMAIN=jircode.com
MAIL_HOSTNAME=mail.jircode.com

# Port Configuration
POSTFIX_PORT_25=25
POSTFIX_PORT_465=465
DOVECOT_PORT_IMAP=993
DOVECOT_PORT_POP3=143

# Security
JIR_LOCAL_KEY=GENERATE_A_RANDOM_KEY_HERE
