# Jîr-Mail Environment Variables for Coolify

# Database Configuration
DATABASE_URL=postgres://postgres:CHANGE_ME@postgres:5432/jir_mail_prod
POSTGRES_DB=jir_mail_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Mail Configuration
MAIL_DOMAIN=jircode.com
MAIL_HOSTNAME=mail.jircode.com
# Gönderim/okuma: jir_* yalnızca tek compose ağı içinde çözülür; ayrı Coolify servislerinde iç hostname verin:
# SMTP_HOST = aynı ağda Postfix'in servis/container adı (örn. Compose'daki service name veya tam konteyner adı)
SMTP_HOST=postfix
SMTP_PORT=587
IMAP_HOST=dovecot
IMAP_PORT=993
# Gerçek Docker adları farklıysa (docker ps çıktısı) eşlemek için:
# JIR_CONTAINER_POSTFIX=myproject-postfix-xxxx
# JIR_CONTAINER_DOVECOT=myproject-dovecot-xxxx

# Port Configuration
POSTFIX_PORT_25=25
POSTFIX_PORT_465=465
DOVECOT_PORT_IMAP=993
DOVECOT_PORT_POP3=143

# Security
JIR_LOCAL_KEY=GENERATE_A_RANDOM_KEY_HERE
