# Dokploy → Compose uygulaması → Environment (tümünü yapıştırın)

JIR_COMPOSE_STACK=1

POSTGRES_DB=jir_mail_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=guclu_sifre_uretin
DATABASE_URL=postgresql://postgres:guclu_sifre_uretin@postgres:5432/jir_mail_prod

MAIL_DOMAIN=jircode.com
MAIL_HOSTNAME=mail.jircode.com
# Traefik Host() — tarayıcıda açtığınız panel adresi (404 oluyorsa bunu domain ile eşleştirin)
PANEL_FQDN=mail.jircode.com
SMTP_HOST=postfix
SMTP_PORT=587
IMAP_HOST=dovecot
IMAP_PORT=993

JIR_LOCAL_KEY=uzun_rastgele_anahtar_uretin

POSTFIX_PORT_25=25
POSTFIX_PORT_587=587
DOVECOT_PORT_IMAP=993
