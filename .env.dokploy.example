# Dokploy → Compose uygulaması → Environment (tümünü yapıştırın, değerleri değiştirin)
# JIR_COMPOSE_STACK compose dosyasında da set; burada da tutmak zararsız.

JIR_COMPOSE_STACK=1

# --- Zorunlu sırlar (zayıf/placeholder reddedilir) ---
SECRET_KEY=django-secret-BURAYA-uzun-rastgele
JIR_LOCAL_KEY=jir-local-key-BURAYA-uzun-rastgele
POSTGRES_PASSWORD=postgres-sifre-BURAYA-guclu
POSTGRES_DB=jir_mail_prod
POSTGRES_USER=postgres
DATABASE_URL=postgresql://postgres:postgres-sifre-BURAYA-guclu@postgres:5432/jir_mail_prod

# --- Mail / panel URL (kendi domaininiz) ---
MAIL_DOMAIN=jircode.com
MAIL_HOSTNAME=mail.jircode.com
PUBLIC_URL=https://mail.jircode.com
CSRF_TRUSTED_ORIGINS=https://mail.jircode.com
# İsteğe bağlı: ALLOWED_HOSTS=mail.jircode.com
# Cloudflare A kaydı için sabit IP (boşsa otomatik bulunur)
# SERVER_PUBLIC_IP=203.0.113.10

SMTP_HOST=postfix
SMTP_PORT=587
IMAP_HOST=dovecot
IMAP_PORT=993

# Host port yayınları (firewall’da 25/587/993 açık olmalı)
POSTFIX_PORT_25=25
POSTFIX_PORT_587=587
DOVECOT_PORT_IMAP=993

# Deploy sonrası stack restart (varsayılan açık)
JIR_AUTO_RESTART_STACK_ON_DEPLOY=1
