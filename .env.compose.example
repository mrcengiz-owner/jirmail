# docker compose up için örnek — .env olarak kopyalayın: cp .env.compose.example .env

POSTGRES_PASSWORD=guclu_sifre_buraya
POSTGRES_DB=jir_mail_prod
POSTGRES_USER=postgres

# Django — production'da zorunlu; rastgele uzun bir değer üretin
SECRET_KEY=django-secret-buraya-uzun-rastgele
# İsteğe bağlı: ALLOWED_HOSTS=mail.jircode.com,localhost
# SESSION_COOKIE_AGE=28800
# MAIL_PASSWORD_SESSION_TTL=14400
# ENABLE_DJANGO_ADMIN=0

MAIL_DOMAIN=jircode.com
MAIL_HOSTNAME=mail.jircode.com
# Mail A kaydı için (Cloudflare auto-DNS). Boşsa sunucu public IP otomatik bulunur.
# SERVER_PUBLIC_IP=203.0.113.10
# Panel HTTPS adresi (CSRF / oturum çerezi — Dokploy’da panel URL’niz)
PUBLIC_URL=https://mail.jircode.com
CSRF_TRUSTED_ORIGINS=https://mail.jircode.com

# Zayıf değerler (change-me vb.) reddedilir — uzun rastgele anahtar kullanın
JIR_LOCAL_KEY=uzun_rastgele_anahtar

DJANGO_PORT=8000
POSTFIX_PORT_25=25
POSTFIX_PORT_587=587
DOVECOT_PORT_IMAP=993
